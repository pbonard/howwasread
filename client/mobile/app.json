{
  "expo": {
    "name": "Howwasread",
    "slug": "mobile",
    "version": "1.4.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "howwasread",
    "userInterfaceStyle": "automatic",
    "ios": {
      "appleTeamId": "363TFV85A8",
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "bundleIdentifier": "com.xcecv.mobile",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        },
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "bitcode": false
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "com.xcecv.mobile",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyA5LxTDMeuljrb9mhjn7BnVQT6RixKXrgM"
        }
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
          "android.permission.ACCESS_COARSE_LOCATION",
          "android.permission.ACCESS_FINE_LOCATION",
          "android.permission.MODIFY_AUDIO_SETTINGS",
          "android.permission.POST_NOTIFICATIONS",
          "android.permission.FOREGROUND_SERVICE",
          "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
          "android.permission.FOREGROUND_SERVICE_MICROPHONE",
          "android.permission.ACCESS_NETWORK_STATE",
          "android.permission.CAMERA",
          "android.permission.INTERNET",
          "android.permission.SYSTEM_ALERT_WINDOW",
          "android.permission.WAKE_LOCK",
          "android.permission.BLUETOOTH",
          "android.permission.READ_EXTERNAL_STORAGE",
          "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera",
          "microphonePermission": "We accesses your microphone to let you exchange ideas with your friends over voice calls.",
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ffffff",
          "defaultChannel": "default",
          "sounds": ["./assets/sounds/notification_sound.mp3"],
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "We accesses your photos to let you share them with your friends."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "We accesses your location to let you see around nearby conversations."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "We accesses your microphone to let you able to exchange ideas over voice call or send voice message.",
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon_transparent_background.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#082247",
          "dark": {
            "backgroundColor": "#082247"
          }
        }
      ],
      "expo-apple-authentication",
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-sqlite",
      [
        "expo-maps",
        {
          "requestLocationPermission": true,
          "locationPermission": "We accesses your location to let you see around nearby conversations."
        }
      ],
      [
        "expo-file-system",
        {
          "supportsOpeningDocumentsInPlace": true,
          "enableFileSharing": true
        }
      ],
      "expo-asset",
      "@bacons/apple-targets",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "seaoferror"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c638278a-d4ca-417f-ba78-046d0b769a71",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.xcecv.mobile.notification-service",
                  "targetName": "notificationservice",
                  "entitlements": {}
                }
              ]
            }
          }
        }
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c638278a-d4ca-417f-ba78-046d0b769a71"
    }
  }
}
